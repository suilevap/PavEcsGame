   "version": "0.2.0",
   "configurations": [
        {
            "name": "C#: PavEcsLiteGame Debug",
            "type": "dotnet",
            "request": "launch",
            "preLaunchTask": "build",
            "projectPath": "${workspaceFolder}/PavEcsLiteGame/PavEcsGame.Lite.csproj"
        },
        {
            "name": "C#: Tetris Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            //"projectPath": "${workspaceFolder}/Tetris/Tetris.csproj",
             "program": "${workspaceFolder}/Tetris/bin/Debug/net10.0/Tetris.dll",
             "args": [],
             "cwd": "${workspaceFolder}",
             "console": "externalTerminal",
             "stopAtEntry": false

        },
                {
            "name": "C#: PavEcsGame.Lite Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            //"projectPath": "${workspaceFolder}/Tetris/Tetris.csproj",
             "program": "${workspaceFolder}/PavEcsLiteGame/bin/Debug/net10.0/PavEcsGame.Lite.dll",
             "args": [],
             "cwd": "${workspaceFolder}/PavEcsLiteGame/bin/Debug/net10.0",
             //"console": "externalTerminal",
             "stopAtEntry": false,
             "externalConsole": true,
             ""

        },
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/PavEcsLiteGame/bin/Debug/net8.0/PavEcsLiteGame.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PavEcsLiteGame",
            // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
            "console": "externalTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
